{
  "manifest_version": 3,
  "name": "TG Media Downloader",
  "version": "1.3",
  "description": "Скачивание медиа и пересылка постов от своего имени в Telegram Web",
  "permissions": ["downloads"],
  "host_permissions": ["https://web.telegram.org/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["downloader.js", "forward.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
